{
  "schemaVersion": 1,
  "id": "armoralert",
  "version": "${version}",
  "name": "ArmorAlert",
  "description": "Real-time armor and offhand durability HUD with animated warnings. PvP-ready alerts for Minecraft Fabric.",
  "authors": [
    {
      "name": "modclaim"
    }
  ],
  "contact": {
    "issues": "https://github.com/modclaim/armoralert/issues",
    "sources": "https://github.com/modclaim/armoralert",
    "homepage": "https://github.com/modclaim/armoralert"
  },
  "license": "MIT",
  "icon": "assets/armoralert/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.armoralert.ArmorAlert"
    ],
    "client": [
      "dev.armoralert.ArmorAlertClient"
    ],
    "modmenu": [
      "dev.armoralert.integration.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "armoralert.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3"
  },
  "suggests": {
    "fabric": "*"
  }
}
